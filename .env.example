# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# optional backup key, used when the first is busy or out of quota
GEMINI_API_KEY_2=
# or gemma-4-26b-a4b-it (faster)
GEMMA_MODEL=gemma-4-31b-it
# only needed when hosting (see render.yaml): sites allowed to call the API, comma-separated
ALLOWED_ORIGINS=
# Gemma calls per visitor per hour, 0 = no limit
RATE_LIMIT_PER_HOUR=0
