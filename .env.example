# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# optional backup key, used when the first is busy or out of quota
GEMINI_API_KEY_2=
# model for study tips, or gemma-4-26b-a4b-it (faster)
GEMMA_MODEL=gemma-4-31b-it
# model for reading photos, or gemini-3.5-flash (slower, stronger)
VISION_MODEL=gemini-3.5-flash-lite
# only needed when hosting (see render.yaml): sites allowed to call the API, comma-separated
ALLOWED_ORIGINS=
# AI calls per visitor per hour, 0 = no limit
RATE_LIMIT_PER_HOUR=0
